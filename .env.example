# Groq API Key (Required)
GROQ_API_KEY=your_groq_api_key_here

# App Settings
APP_NAME=Al-Dustour AI
APP_VERSION=1.0.0
DEBUG=false

# LLM Settings
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# Embeddings Settings
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu

# Vector Store Settings
RETRIEVAL_K=5

# Document Processing Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=200
PDF_PATH=data/Egyptian_Constitution.pdf

# Server Settings
HOST=0.0.0.0
PORT=8000
